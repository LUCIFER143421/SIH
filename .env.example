# CRIMENET AI Environment Configuration

# Database
DB_PATH=data/crimenet.db

# Knowledge Graph Backend (networkx | neo4j)
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Local LLM Configuration (ollama | deterministic)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
